# ==============================================================================
# Saans Environment Variables
# Copy to .env.local for local development. Never commit sensitive keys!
# ==============================================================================

# Google Gemini API Key (Required for live GenAI features; fallback works without it)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (never hardcoded in application source)
GEMINI_MODEL=gemini-2.0-flash

# Environment Mode
NODE_ENV=development

# Optional Rate Limiting Overrides (requests per 60-second window)
RATE_LIMIT_PER_MINUTE=60
