{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "mutate": [
    "lib/aqi/**/*.ts",
    "lib/impact/**/*.ts",
    "lib/rules/**/*.ts",
    "!lib/aqi/types.ts",
    "!lib/impact/types.ts"
  ],
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text"],
  "thresholds": {
    "high": 85,
    "low": 80,
    "break": 80
  },
  "coverageAnalysis": "perTest"
}
